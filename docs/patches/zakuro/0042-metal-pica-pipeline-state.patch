 fn key_fragment(key: &PipelineKey) -> [u32; FRAGMENT_CONSTANTS] {
-    let _ = key;
-    let mut values = [0u32; FRAGMENT_CONSTANTS];
+    let mut values = key.fragment;
     values[29] = 1; // DYNAMIC: the specials carry the draw's own
     values
 }
