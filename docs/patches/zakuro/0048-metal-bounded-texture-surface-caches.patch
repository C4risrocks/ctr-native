 }
+/// the textures the cache keeps: beyond either limit, the least recently
+/// bound go; a draw holding one keeps its own reference to the Metal texture.
+const PICA_TEXTURE_ENTRIES: usize = 256;
+const PICA_TEXTURE_BYTES: usize = 64 << 20;
+
 pub(super) struct Texture {
     image: Retained<ProtocolObject<dyn MTLTexture>>,
     texels: Arc<[[u8; 4]]>,
     width: u32,
     height: u32,
     levels: u32,
+    used: u64,
 }
 impl HardwareMetal {
     pub(crate) fn bind_pica_texture(
@@ -57,14 +63,24 @@ impl HardwareMetal {
         if bound.texels.len() != count {
             return Err("Metal mip chain length mismatch".into());
         }
+        self.clock += 1;
+        let stamp = self.clock;
         let key = Arc::as_ptr(&bound.texels) as *const [u8; 4] as usize;
-        let cached = self.pica_textures.get(&key).is_some_and(|entry| {
-            Arc::ptr_eq(&entry.texels, &bound.texels)
-                && entry.width == bound.width
-                && entry.height == bound.height
-                && entry.levels == bound.levels
-        });
+        let cached = match self.pica_textures.get_mut(&key) {
+            Some(entry)
+                if Arc::ptr_eq(&entry.texels, &bound.texels)
+                    && entry.width == bound.width
+                    && entry.height == bound.height
+                    && entry.levels == bound.levels =>
+            {
+                entry.used = stamp;
+                true
+            }
+            _ => false,
+        };
         if !cached {
+            self.pica_textures.remove(&key);
+            self.make_texture_room(bound.texels.len() * 4);
             let descriptor = MTLTextureDescriptor::new();
             descriptor.setPixelFormat(MTLPixelFormat::RGBA8Unorm);
             descriptor.setStorageMode(MTLStorageMode::Managed);
@@ -108,6 +124,7 @@ impl HardwareMetal {
                     width: bound.width,
                     height: bound.height,
                     levels: bound.levels,
+                    used: stamp,
                 },
             );
         }
@@ -147,6 +164,17 @@ impl HardwareMetal {
             sampler: self.pica_samplers[&filtering].clone(),
         })
     }
+
+    /// drops the least recently bound textures until one of `bytes` fits both limits.
+    fn make_texture_room(&mut self, bytes: usize) {
+        let mut held: usize = self.pica_textures.values().map(|entry| entry.texels.len() * 4).sum();
+        while !self.pica_textures.is_empty()
+            && (self.pica_textures.len() >= PICA_TEXTURE_ENTRIES || held + bytes > PICA_TEXTURE_BYTES)
+        {
+            let oldest = *self.pica_textures.iter().min_by_key(|(_, entry)| entry.used).expect("a texture").0;
+            held -= self.pica_textures.remove(&oldest).expect("the oldest texture").texels.len() * 4;
+        }
+    }
 }
 
 #[derive(Clone, Copy, Default)]
@@ -412,4 +440,76 @@ mod resource_tests {
         bound.texels = Arc::from(vec![[0u8; 4]]);
