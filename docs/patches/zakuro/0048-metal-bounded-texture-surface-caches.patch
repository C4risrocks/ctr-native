+    #[test]
+    fn surfaces_past_the_limit_are_trimmed_least_recently_used_first() {
+        let mut hardware = HardwareMetal::new().expect("the Metal raster constructs");
+        let mut memory = HostMemory::new();
+        hardware.check_surface(&mut memory, 0x4000, (16, 16), ColorFormat::Rgba8, false).unwrap();
+        hardware.check_surface(&mut memory, 0x1000, (16, 16), ColorFormat::Rgba8, false).unwrap();
+        for index in 0..SURFACE_ENTRIES as u32 {
+            hardware
+                .check_surface(&mut memory, 0x10_0000 + index * 0x1000, (16, 16), ColorFormat::Rgba8, false)
+                .unwrap();
+        }
+        hardware.check_surface(&mut memory, 0x1000, (16, 16), ColorFormat::Rgba8, false).unwrap();
+        hardware.trim_surfaces();
+        let addrs: Vec<u32> = hardware.surfaces.iter().map(|surface| surface.addr).collect();
+        assert_eq!(addrs.len(), SURFACE_ENTRIES);
+        assert!(!addrs.contains(&0x4000), "the least recently used goes first");
+        assert!(!addrs.contains(&0x10_0000), "then the oldest of the rest");
+        assert!(addrs.contains(&0x1000), "a surface used again stays");
+    }
+
