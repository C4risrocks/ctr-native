 /// size, input height, output height, scale, flip, and the two formats.
 #[cfg(all(target_os = "macos", feature = "metal"))]
 impl HardwareMetal {
+    /// drops the least recently used surfaces beyond the limit. surfaces hold
+    /// nothing memory lacks (every write-back is synchronous), so a dropped
+    /// one reloads on its next use.
+    fn trim_surfaces(&mut self) {
+        while self.surfaces.len() > SURFACE_ENTRIES {
+            let oldest = self.surfaces.iter().enumerate()
+                .min_by_key(|(_, surface)| surface.used)
+                .map(|(index, _)| index)
+                .expect("a surface");
+            self.surfaces.remove(oldest);
+        }
+    }
+
     pub(crate) fn display_transfer<M: crate::GpuMemory>(
         &mut self,
         memory: &mut M,
@@ -1564,6 +1590,7 @@ impl HardwareMetal {
             return Err("Metal transfer execution failed".into());
         }
         self.write_back(memory, output_index)?;
+        self.trim_surfaces();
         Ok(())
     }
 }
