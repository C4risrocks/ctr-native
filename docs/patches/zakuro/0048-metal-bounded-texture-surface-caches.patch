+
+    fn texture(seed: u32, side: u32) -> BoundTexture {
+        BoundTexture {
+            texels: Arc::from(vec![[seed as u8, 0, 0, 255]; (side * side) as usize]),
+            drawn: None,
+            linear: false,
+            wrap_s: Wrap::Repeat,
+            wrap_t: Wrap::Repeat,
+            width: side,
+            height: side,
+            border: [0.0; 4],
+            replacement: None,
+            levels: 1,
+            lod: super::super::super::Lod::default(),
+        }
+    }
+
+    fn key(bound: &BoundTexture) -> usize {
+        Arc::as_ptr(&bound.texels) as *const [u8; 4] as usize
+    }
+
+    #[test]
+    fn pica_textures_stay_within_their_entry_limit() {
+        let mut hardware = HardwareMetal::new().unwrap();
+        let first = texture(0, 16);
+        let kept = hardware.bind_pica_texture(&first).unwrap();
+        for seed in 1..PICA_TEXTURE_ENTRIES as u32 + 8 {
+            hardware.bind_pica_texture(&texture(seed, 16)).unwrap();
+        }
+        assert_eq!(hardware.pica_textures.len(), PICA_TEXTURE_ENTRIES);
+        assert!(!hardware.pica_textures.contains_key(&key(&first)), "the oldest binding went");
+        let mut pixel = [0u8; 4];
+        unsafe {
+            kept.texture.getBytes_bytesPerRow_fromRegion_mipmapLevel(
+                NonNull::from(&mut pixel[..]).cast(),
+                4,
+                MTLRegion {
+                    origin: MTLOrigin { x: 0, y: 0, z: 0 },
+                    size: MTLSize { width: 1, height: 1, depth: 1 },
+                },
+                0,
+            );
+        }
+        assert_eq!(pixel, [0, 0, 0, 255], "a draw's binding outlives its eviction");
+    }
+
+    #[test]
+    fn a_rebound_texture_outlives_the_least_recently_bound() {
+        let mut hardware = HardwareMetal::new().unwrap();
+        let first = texture(0, 16);
+        let second = texture(1, 16);
+        hardware.bind_pica_texture(&first).unwrap();
+        hardware.bind_pica_texture(&second).unwrap();
+        for seed in 2..PICA_TEXTURE_ENTRIES as u32 {
+            hardware.bind_pica_texture(&texture(seed, 16)).unwrap();
+        }
+        hardware.bind_pica_texture(&first).unwrap();
+        hardware.bind_pica_texture(&texture(PICA_TEXTURE_ENTRIES as u32, 16)).unwrap();
+        assert!(hardware.pica_textures.contains_key(&key(&first)), "the rebound texture stays");
+        assert!(!hardware.pica_textures.contains_key(&key(&second)), "the least recently bound goes");
+    }
+
+    #[test]
+    fn pica_textures_stay_within_their_byte_budget() {
+        let mut hardware = HardwareMetal::new().unwrap();
+        for seed in 0..80u32 {
+            hardware.bind_pica_texture(&texture(seed, 512)).unwrap();
+        }
+        let held: usize = hardware.pica_textures.values().map(|entry| entry.texels.len() * 4).sum();
+        assert!(held <= PICA_TEXTURE_BYTES, "held {held} bytes");
+        assert!(hardware.pica_textures.len() < 80);
+    }
 }
