# Nothing of any game in this repository (files or keys).
*.3ds
*.3dz
*.3dsx
*.cci
*.cia
*.cxi
*.cfa
*.xci
# Switch formats are excluded too.
*.nsp

# Console keys: your boot9/movable-sed stay on your machine.
*.bin.keys
boot9*
*.otp
movable.sed
keys.txt

# Build products and caches.
*_build/
*.app/
# *.app/ only matches dirs ending in ".app": bundles are named *.app.ctr-native
# and hold the user sandbox (saves/logs/caches) - never commit them.
*.app.ctr-native/
*.app.ctr-native-legacy/
*.app.key
*.idx
.DS_Store
._*

# Packaging/library noise.
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytype/
.ruff_cache/
.archify/
built-diagrams/

# Editor noise.
.idea/
.vscode/
*.swp
vendors/
